PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/lms_portal

# JWT Configuration (Must be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long!
JWT_EXPIRE=30d

# Optional Administrative Registration Setup Key
ADMIN_REGISTRATION_KEY=

# Cloudinary (Optional - uses local uploads directory if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
